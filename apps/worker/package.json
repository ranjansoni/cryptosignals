{
  "name": "@crypto-signals/worker",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "job:hourly": "ts-node src/cli.ts hourly",
    "job:daily": "ts-node src/cli.ts daily",
    "job:weekly": "ts-node src/cli.ts weekly",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@crypto-signals/shared": "*",
    "@prisma/client": "^5.7.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}

